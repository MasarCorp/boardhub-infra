# Local secrets / env overrides
.env
.env.local
*.tfvars
!terraform.tfvars.example

# Terraform state (will live remotely in S3 once provisioned)
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log

# Helm
charts/*.tgz

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Claude Code
.claude/*
# Share the project's workflows and slash commands; keep personal settings out.
# A negation cannot re-include a path under an excluded DIRECTORY, so the rule above
# has to be `.claude/*` rather than `.claude/`.
!.claude/workflows/
!.claude/commands/

# Logs
*.log
