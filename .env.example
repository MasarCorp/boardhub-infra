# boardhub-infra local stack — environment template.
#
# Copy this file to `.env` (same directory as docker-compose.dev.yml) and fill in
# the values you need. `.env` is gitignored — never commit real keys.
#   cp .env.example .env
#
# The stack BOOTS without any of these, but AI Assist will read as unauthenticated
# until MAGALES_SERVICE_USERNAME / MAGALES_SERVICE_PASSWORD are set (see below).

# ── AI providers (needed for live AI Assist / insights / transcription) ──
# OpenRouter is the default provider — set this to make the AI features work.
OPENROUTER_API_KEY=
# Optional extra providers:
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# Self-hosted models via Ollama on the host (default shown):
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ── AI service account (REQUIRED for AI Assist to read your data) ──
# The credentials ai-services uses to call the backend REST API. There is no
# default any more, in either config.py or docker-compose.dev.yml: a published
# default is the live configuration everywhere nobody overrode it, which is
# exactly what finding 1 was about.
#
# Unset, the worker logs one explicit error and its calls read as ANONYMOUS —
# which looks like empty data, not like a misconfiguration. So if AI Assist
# suddenly answers "there are no meetings", check these first.
#
# Left EMPTY on purpose. A template is copied verbatim, so a working pair
# written here is a published default again by another route — which is the
# whole of finding 1. For a local stack, use the dev admin seeded by
# `boardhub/src/main/resources/data-postgres.sql` (search it for the `admin`
# row); for anything shared, issue a dedicated account.
#
# The account still wants narrowing: it is SUPER_ADMIN today, which is far more
# than the worker needs. Tracked as roadmap backlog item 24.
MAGALES_SERVICE_USERNAME=
MAGALES_SERVICE_PASSWORD=

# ── Inter-service auth (ADR-0004) ──
# Shared HMAC secret; MUST be identical for the `api` and `ai-services` services.
# The default below works for local dev — override only if you rotate it.
AI_SERVICE_HMAC_SECRET=dev-ai-hmac-secret-change-me-32-chars-min

# ── Transcription (speech-to-text) ──
TRANSCRIBE_PROVIDER=openrouter
TRANSCRIBE_OPENROUTER_MODEL=google/gemini-2.5-flash
WHISPER_MODEL=medium

# ── Insights scheduler ──
INSIGHTS_REFRESH_MINUTES=30
INSIGHTS_TENANTS_CSV=acme,globex

# ── Optional bootstrap super-admin (leave blank to skip) ──
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=

# ── e-signature webhook (optional) ──
SAYNEE_WEBHOOK_SECRET=
