# boardhub-infra local stack — environment template.
#
# Copy this file to `.env` (same directory as docker-compose.dev.yml) and fill in
# the values you need. `.env` is gitignored — never commit real keys.
#   cp .env.example .env
#
# The stack BOOTS without any of these (every var has a safe default); you only
# need them to enable live AI and to customize dev behavior.

# ── AI providers (needed for live AI Assist / insights / transcription) ──
# OpenRouter is the default provider — set this to make the AI features work.
OPENROUTER_API_KEY=
# Optional extra providers:
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# Self-hosted models via Ollama on the host (default shown):
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ── Inter-service auth (ADR-0004) ──
# Shared HMAC secret; MUST be identical for the `api` and `ai-services` services.
# The default below works for local dev — override only if you rotate it.
AI_SERVICE_HMAC_SECRET=dev-ai-hmac-secret-change-me-32-chars-min

# ── Transcription (speech-to-text) ──
TRANSCRIBE_PROVIDER=openrouter
TRANSCRIBE_OPENROUTER_MODEL=google/gemini-2.5-flash
WHISPER_MODEL=medium

# ── Insights scheduler ──
INSIGHTS_REFRESH_MINUTES=30
INSIGHTS_TENANTS_CSV=acme,globex

# ── Optional bootstrap super-admin (leave blank to skip) ──
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=

# ── e-signature webhook (optional) ──
SAYNEE_WEBHOOK_SECRET=
